---
import '../styles/global.css';
import { content, type Lang } from '../data/content';
interface Props { lang: Lang; title?: string; description?: string; switchPath: string }
const { lang, title, description, switchPath } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const home = `/${lang}/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <link rel="alternate" hreflang={other} href={`/${other}${switchPath}`} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { localStorage.setItem('lang', document.documentElement.lang); } catch (e) {}
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href={home}>{t.hero.name}</a>
        <a class="link" href={`${home}#about`}>{t.nav.about}</a>
        <a class="link" href={`${home}#experience`}>{t.nav.experience}</a>
        <a class="link" href={`${home}#cases`}>{t.nav.cases}</a>
        <a class="link" href={`${home}#contacts`}>{t.nav.contacts}</a>
        <nav class="lang" aria-label="Language">
          <a href={`/ru${switchPath}`} aria-current={lang === 'ru'} hreflang="ru">RU</a>
          <a href={`/en${switchPath}`} aria-current={lang === 'en'} hreflang="en">EN</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer><div class="wrap">{t.footer}</div></footer>
    <script is:inline>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
