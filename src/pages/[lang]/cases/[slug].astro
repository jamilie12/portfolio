---
import Base from '../../../layouts/Base.astro';
import Blocks from '../../../components/Blocks.astro';
import { content, langs, type Lang, type Block } from '../../../data/content';
import { caseImages, groupTitles, videoTitle } from '../../../data/images';
export function getStaticPaths() {
  return langs.flatMap((lang) => content[lang].cases.map((c) => ({ params: { lang, slug: c.slug } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = content[lang];
const idx = t.cases.findIndex((c) => c.slug === slug);
const c = t.cases[idx];
const img = caseImages[slug];
const next = t.cases[(idx + 1) % t.cases.length];
const mainBlocks = c.blocks.filter((b) => b.group !== 'research');
const embedIdx = mainBlocks.findIndex((b) => b.embed || b.image);
const marker = embedIdx >= 0 ? mainBlocks[embedIdx] : null;
const beforeEmbed = embedIdx >= 0 ? mainBlocks.slice(0, embedIdx) : mainBlocks;
const afterEmbed = embedIdx >= 0 ? mainBlocks.slice(embedIdx + 1) : [];
const researchBlocks = c.blocks.filter((b) => b.group === 'research');
type Seg = { kind: 'text'; blocks: Block[] } | { kind: 'images'; images: string[] };
const researchSegments: Seg[] = [];
for (const b of researchBlocks) {
  if (b.images) researchSegments.push({ kind: 'images', images: b.images });
  else {
    const last = researchSegments[researchSegments.length - 1];
    if (last && last.kind === 'text') last.blocks.push(b);
    else researchSegments.push({ kind: 'text', blocks: [b] });
  }
}
---
<Base lang={lang} title={`${c.title} — ${t.hero.name}`} description={c.subtitle} switchPath={`/cases/${slug}/`}>
  <div class="wrap">
    <header class="case-head">
      <a class="back" href={`/${lang}/#cases`}>← {t.casesSection.back}</a>
      <p class="eyebrow">{c.tag}</p>
      <h1>{c.title}</h1>
      <p class="sub">{c.subtitle}</p>
      <img class="case-cover" src={img.cover} alt={img.alt[lang]} />
    </header>
    <Blocks blocks={beforeEmbed} />
    {marker?.image && (
      <figure class="case-figure">
        <img src={marker.image} alt={`${c.title} — benchmark`} loading="lazy" />
      </figure>
    )}
    {img.embed && !marker?.image && (
      <section class="embed-block" id="embed">
        {embedIdx < 0 && <h2>{img.embed.title[lang]}</h2>}
        <iframe class="case-embed" src={img.embed.src} title={img.embed.title[lang]} loading="lazy" allowfullscreen></iframe>
      </section>
    )}
    {afterEmbed.length > 0 && <Blocks blocks={afterEmbed} />}
    {img.video && !img.videoGroup && (
      <section class="gallery-group" id="video">
        <h2>{(img.videoTitle ?? videoTitle)[lang]}</h2>
        <video class="case-video" src={img.video} poster={img.cover} controls playsinline preload="metadata"></video>
      </section>
    )}
    {img.groups.map((g) => (
      <section class="gallery-group" id={g.key}>
        <h2>{groupTitles[g.key][lang]}</h2>
        {img.video && img.videoGroup === g.key && (
          <>
            <h3 class="sub-title">{(img.videoTitle ?? videoTitle)[lang]}</h3>
            <video class="case-video" src={img.video} poster={img.cover} controls playsinline preload="metadata"></video>
          </>
        )}
        {g.key === 'research' && researchSegments.map((seg) =>
          seg.kind === 'text' ? (
            <Blocks blocks={seg.blocks} research />
          ) : (
            <div class="gallery gallery-inline">
              {seg.images.map((src) => <img src={src} alt={`${groupTitles[g.key][lang]} — ${img.alt[lang]}`} loading="lazy" />)}
            </div>
          )
        )}
        {g.images.length > 0 && (
          <div class="gallery">
            {g.images.map((src) => <img src={src} alt={`${groupTitles[g.key][lang]} — ${img.alt[lang]}`} loading="lazy" />)}
          </div>
        )}
      </section>
    ))}
    <nav class="case-nav">
      <a class="btn ghost" href={`/${lang}/#cases`}>← {t.casesSection.back}</a>
      <a class="btn primary" href={`/${lang}/cases/${next.slug}/`}>{next.title} →</a>
    </nav>
  </div>
</Base>
